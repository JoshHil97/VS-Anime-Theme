{
  // ============================================================
  //  EDITOR — Font & Ligatures (JetBrains Mono)
  // ============================================================
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.fontWeight": "400",

  // ============================================================
  //  EDITOR — General behaviour
  // ============================================================
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "editor.smoothScrolling": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.suggestSelection": "first",
  "editor.multiCursorModifier": "alt",
  "editor.wordWrap": "off",
  "editor.rulers": [80, 100],
  "editor.renderWhitespace": "boundary",

  // ============================================================
  //  EDITOR — Inlay hints (parameters, types, enums)
  // ============================================================
  "editor.inlayHints.enabled": "on",
  "editor.inlayHints.fontSize": 12,
  "editor.inlayHints.padding": true,

  // TypeScript / JavaScript inlay hints
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "javascript.inlayHints.parameterNames.enabled": "all",
  "javascript.inlayHints.parameterTypes.enabled": true,
  "javascript.inlayHints.variableTypes.enabled": true,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": true,

  // ============================================================
  //  TYPESCRIPT — Strict-mode & IntelliSense hygiene
  //  (Real enforcement lives in tsconfig.json "strict": true.
  //   These make the editor surface strictness aggressively.)
  // ============================================================
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.quoteStyle": "single",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.completeFunctionCalls": true,
  "typescript.reportStyleChecksAsWarnings": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "js/ts.implicitProjectConfig.strictNullChecks": true,
  "js/ts.implicitProjectConfig.strictFunctionTypes": true,

  // ============================================================
  //  FORMAT / LINT — Prettier + ESLint on save
  // ============================================================
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.run": "onType",
  "prettier.singleQuote": true,
  "prettier.semi": true,
  "prettier.trailingComma": "all",
  "prettier.printWidth": 100,
  "prettier.tabWidth": 2,

  // ============================================================
  //  TABS / INDENTATION — TypeScript
  // ============================================================
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ============================================================
  //  TABS / INDENTATION — Shopify Liquid
  //  (Formatting handled by the Shopify Liquid extension.)
  // ============================================================
  "[liquid]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.defaultFormatter": "Shopify.theme-check-vscode",
    "editor.formatOnSave": true
  },
  "files.associations": {
    "*.liquid": "liquid",
    "**/sections/*.liquid": "liquid",
    "**/snippets/*.liquid": "liquid",
    "**/blocks/*.liquid": "liquid"
  },
  "liquid.format.enable": true,
  "themeCheck.checkOnSave": true,

  // ============================================================
  //  FILES & EXPLORER
  // ============================================================
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "onFocusChange",
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.test.ts, ${capture}.spec.ts",
    "*.tsx": "${capture}.ts, ${capture}.css, ${capture}.module.css",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc, .nvmrc",
    "*.liquid": "${capture}.json"
  },

  // ============================================================
  //  WORKBENCH — Theme & Icons (Catppuccin + Material Icons)
  // ============================================================
  "workbench.colorTheme": "Dark Modern",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editor.enablePreview": false,
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 16,

  // ---- Black & gold accent (anime aesthetic) ----
  // Layers a near-black background + gold UI accents over the base theme.
  "workbench.colorCustomizations": {
    "editor.background": "#0a0a0b",
    "sideBar.background": "#0d0d0f",
    "sideBarSectionHeader.background": "#0d0d0f",
    "activityBar.background": "#0a0a0b",
    "activityBar.foreground": "#e6b450",
    "activityBar.inactiveForeground": "#7a6a3a",
    "activityBar.activeBorder": "#e6b450",
    "panel.background": "#0a0a0b",
    "titleBar.activeBackground": "#0a0a0b",
    "titleBar.activeForeground": "#e6b450",
    "statusBar.background": "#0d0d0f",
    "statusBar.foreground": "#e6b450",
    "statusBar.noFolderBackground": "#0d0d0f",
    "tab.activeBackground": "#141414",
    "tab.activeForeground": "#f5d98b",
    "tab.activeBorderTop": "#e6b450",
    "editorGroupHeader.tabsBackground": "#0a0a0b",
    "editorCursor.foreground": "#ffd369",
    "editor.selectionBackground": "#e6b45033",
    "editor.lineHighlightBackground": "#ffffff08",
    "list.activeSelectionForeground": "#e6b450",
    "list.highlightForeground": "#e6b450",
    "focusBorder": "#e6b450",
    "button.background": "#e6b450",
    "button.foreground": "#0a0a0b",
    "badge.background": "#e6b450",
    "badge.foreground": "#0a0a0b",
    "progressBar.background": "#e6b450",
    "textLink.foreground": "#e6b450",
    "panelTitle.activeBorder": "#e6b450",
    "scrollbarSlider.activeBackground": "#e6b45066"
  },
  // Gentle gold tint on keywords/functions; other syntax colors stay readable.
  "editor.tokenColorCustomizations": {
    "keywords": "#e6b450",
    "functions": "#ffd369",
    "types": "#d7b877"
  },

  // ============================================================
  //  ERROR LENS
  // ============================================================
  "errorLens.enabledDiagnosticLevels": ["error", "warning", "info"],
  "errorLens.excludeBySource": ["cSpell", "Grammarly"],
  "errorLens.messageEnabled": true,
  "errorLens.followCursor": "allLines",

  // ============================================================
  //  BETTER COMMENTS — anime-flavoured tag colours
  // ============================================================
  "better-comments.tags": [
    { "tag": "!", "color": "#FF2D55", "strikethrough": false, "bold": true },
    { "tag": "?", "color": "#3498DB", "strikethrough": false },
    { "tag": "todo", "color": "#FF8C00", "strikethrough": false, "bold": true },
    { "tag": "*", "color": "#98C379", "strikethrough": false },
    { "tag": "//", "color": "#7F848E", "strikethrough": true }
  ],

  // ============================================================
  //  GIT / GITLENS
  // ============================================================
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.codeLens.enabled": true,

  // ============================================================
  //  TERMINAL
  // ============================================================
  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",

  // ============================================================
  //  BACKGROUND EXTENSION — anime wallpaper (low opacity)
  //  Extension: shalldie.background
  //  Replace the placeholder path/URL below with your wallpaper.
  //  Opacity kept at 0.10–0.15 so code stays fully readable.
  // ============================================================
  "background.enabled": true,
  "background.editor": {
    "useFront": true,
    "style": {
      "background-position": "100% 100%",
      "background-repeat": "no-repeat",
      "background-size": "42% auto",
      "opacity": 0.16
    },
    "images": [
      // Bundled wallpaper: assets/wallpaper/anime-verses.png
      // The Background extension needs an ABSOLUTE file:// path — replace the
      // path below with the absolute location of this repo on your machine.
      //   macOS/Linux: "file:///Users/you/VS-Anime-Theme/assets/wallpaper/anime-verses.png"
      //   Windows:     "file:///C:/Users/you/VS-Anime-Theme/assets/wallpaper/anime-verses.png"
      "file:///ABSOLUTE/PATH/TO/VS-Anime-Theme/assets/wallpaper/anime-verses.png"
    ],
    "interval": 0,
    "random": false
  },
  // Full-window variant (covers sidebar + panels). Disabled by default;
  // flip "enabled" to true if you prefer a whole-window wash instead.
  "background.fullscreen": {
    "enabled": false,
    "image": "file:///ABSOLUTE/PATH/TO/VS-Anime-Theme/assets/wallpaper/anime-verses.png",
    "opacity": 0.1,
    "size": "cover",
    "position": "center",
    "interval": 0,
    "random": false
  },

  // ============================================================
  //  DISCORD RICH PRESENCE — anime-style status
  //  Extension: icrawl.discord-vscode  (a.k.a. "Discord Presence")
  // ============================================================
  "discord.enabled": true,
  "discord.suppressNotifications": true,
  "discord.showElapsedTime": true,
  "discord.detailsEditing": "⚔️ Editing {file_name}",
  "discord.detailsIdling": "🌸 Idling in the code dojo",
  "discord.lowerDetailsEditing": "📂 In {workspace} — {file_size}",
  "discord.lowerDetailsIdling": "💤 Taking a filler-arc break",
  "discord.lowerDetailsNoWorkspaceFound": "🎌 No workspace — freestyle coding",
  "discord.largeImageIdling": "Idling",
  "discord.removeElapsedTime": false,
  "discord.removeRemoteRepository": false
}
