{
  // ============================================================
  //  Shopify Liquid section / block / snippet boilerplate
  //  Scope: liquid. Type the prefix + Tab to expand.
  // ============================================================

  "Liquid: Section with schema": {
    "scope": "liquid",
    "prefix": "lsection",
    "body": [
      "{%- liquid",
      "  assign section_id = section.id",
      "-%}",
      "",
      "<section",
      "  class=\"${1:section-name} color-{{ section.settings.color_scheme }}\"",
      "  style=\"padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;\"",
      ">",
      "  <div class=\"page-width\">",
      "    {%- if section.settings.heading != blank -%}",
      "      <h2 class=\"${1:section-name}__heading\">{{ section.settings.heading | escape }}</h2>",
      "    {%- endif -%}",
      "    ${0}",
      "  </div>",
      "</section>",
      "",
      "{% schema %}",
      "{",
      "  \"name\": \"${2:Section Name}\",",
      "  \"tag\": \"section\",",
      "  \"class\": \"section\",",
      "  \"settings\": [",
      "    {",
      "      \"type\": \"text\",",
      "      \"id\": \"heading\",",
      "      \"label\": \"Heading\",",
      "      \"default\": \"${3:Heading}\"",
      "    },",
      "    {",
      "      \"type\": \"color_scheme\",",
      "      \"id\": \"color_scheme\",",
      "      \"label\": \"Color scheme\",",
      "      \"default\": \"scheme-1\"",
      "    },",
      "    {",
      "      \"type\": \"range\",",
      "      \"id\": \"padding_top\",",
      "      \"min\": 0, \"max\": 100, \"step\": 4, \"unit\": \"px\",",
      "      \"label\": \"Padding top\", \"default\": 40",
      "    },",
      "    {",
      "      \"type\": \"range\",",
      "      \"id\": \"padding_bottom\",",
      "      \"min\": 0, \"max\": 100, \"step\": 4, \"unit\": \"px\",",
      "      \"label\": \"Padding bottom\", \"default\": 40",
      "    }",
      "  ],",
      "  \"presets\": [{ \"name\": \"${2:Section Name}\" }]",
      "}",
      "{% endschema %}",
      ""
    ],
    "description": "Full Shopify section with schema, settings & preset"
  },

  "Liquid: Section with blocks loop": {
    "scope": "liquid",
    "prefix": "lblocks",
    "body": [
      "<div class=\"${1:section-name}\">",
      "  {%- for block in section.blocks -%}",
      "    {%- case block.type -%}",
      "      {%- when '${2:item}' -%}",
      "        <div class=\"${1:section-name}__item\" {{ block.shopify_attributes }}>",
      "          {{ block.settings.${3:text} }}",
      "        </div>",
      "    {%- endcase -%}",
      "  {%- endfor -%}",
      "</div>",
      "",
      "{% schema %}",
      "{",
      "  \"name\": \"${4:Section Name}\",",
      "  \"blocks\": [",
      "    {",
      "      \"type\": \"${2:item}\",",
      "      \"name\": \"${5:Item}\",",
      "      \"settings\": [",
      "        { \"type\": \"text\", \"id\": \"${3:text}\", \"label\": \"Text\" }",
      "      ]",
      "    }",
      "  ],",
      "  \"max_blocks\": 12,",
      "  \"presets\": [{ \"name\": \"${4:Section Name}\", \"blocks\": [{ \"type\": \"${2:item}\" }] }]",
      "}",
      "{% endschema %}",
      ""
    ],
    "description": "Section iterating over theme-editor blocks"
  },

  "Liquid: Renderable snippet with params": {
    "scope": "liquid",
    "prefix": "lsnippet",
    "body": [
      "{%- comment -%}",
      "  Renders ${1:component}",
      "  Accepts:",
      "  - ${2:title}: {String}",
      "  Usage:",
      "  {% render '${3:snippet-name}', ${2:title}: 'Hello' %}",
      "{%- endcomment -%}",
      "",
      "{%- liquid",
      "  assign ${2:title} = ${2:title} | default: ''",
      "-%}",
      "",
      "<div class=\"${1:component}\">",
      "  ${0}",
      "</div>",
      ""
    ],
    "description": "Documented, parameterized Liquid snippet"
  },

  "Liquid: Product card": {
    "scope": "liquid",
    "prefix": "lproductcard",
    "body": [
      "{%- liquid",
      "  assign product = ${1:product}",
      "-%}",
      "<a href=\"{{ product.url }}\" class=\"product-card\">",
      "  {%- if product.featured_media -%}",
      "    {{ product.featured_media | image_url: width: 600 | image_tag:",
      "      loading: 'lazy',",
      "      widths: '300, 600, 900',",
      "      class: 'product-card__image'",
      "    }}",
      "  {%- endif -%}",
      "  <h3 class=\"product-card__title\">{{ product.title | escape }}</h3>",
      "  <span class=\"product-card__price\">{{ product.price | money }}</span>",
      "</a>",
      ""
    ],
    "description": "Responsive product card with lazy image"
  },

  "Liquid: for loop with forloop meta": {
    "scope": "liquid",
    "prefix": "lfor",
    "body": [
      "{%- for ${1:item} in ${2:collection} -%}",
      "  ${0}",
      "{%- else -%}",
      "  {%- comment -%} empty state {%- endcomment -%}",
      "{%- endfor -%}"
    ],
    "description": "Liquid for/else loop"
  },

  "Liquid: paginate": {
    "scope": "liquid",
    "prefix": "lpaginate",
    "body": [
      "{%- paginate ${1:collection.products} by ${2:12} -%}",
      "  {%- for ${3:product} in ${1:collection.products} -%}",
      "    ${0}",
      "  {%- endfor -%}",
      "  {{ paginate | default_pagination }}",
      "{%- endpaginate -%}"
    ],
    "description": "Paginated collection loop"
  }
}
